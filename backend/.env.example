# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.zcv7mlm.mongodb.net/file_management_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_access_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=https://smartdocs.id.vn

# Email SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_VERIFY_EXPIRES_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=15

# AI Configuration (Google Gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.6-flash

# MinIO / Object Storage Configuration
# Đặt STORAGE_DRIVER=minio khi triển khai trên Render / Production
STORAGE_DRIVER=minio
MINIO_ENDPOINT=minio.yourdomain.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=smartdocs-files
