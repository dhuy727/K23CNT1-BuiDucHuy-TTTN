# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/user_management_db

# JWT Configuration (secretToken / Access Token - ngắn hạn)
JWT_SECRET=super_secret_access_key_k23cnt1_2026
JWT_EXPIRES_IN=15m

# JWT Configuration (refreshToken - dài hạn)
JWT_REFRESH_SECRET=super_secret_refresh_key_k23cnt1_2026
JWT_REFRESH_EXPIRES_IN=7d

# Email verification code and password reset (use a Gmail App Password, never your normal password)
CLIENT_URL=http://localhost:3000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_VERIFY_EXPIRES_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=15

# AI classification (Gemini mặc định; đổi openai hoặc openai-compatible nếu cần)
# Upload không chờ AI. Thiếu key: file vẫn dùng được, aiStatus=failed.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
# Chỉ dùng khi AI_PROVIDER=openai hoặc openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
