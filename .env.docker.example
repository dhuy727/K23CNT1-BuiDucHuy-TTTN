# Cấu hình môi trường cho Docker Compose (Đổi tên thành .env khi triển khai)
PORT=3000
NODE_ENV=production

# Kết nối CSDL trong mạng Docker
MONGO_URI=mongodb://mongodb:27017/docuflow_db

# Kết nối Redis cho Hàng đợi Tác vụ Nền (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Khóa bí mật JWT
JWT_SECRET=super_secret_access_key_k23cnt1_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_k23cnt1_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình Trí tuệ Nhân tạo (Gemini / OpenAI)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=your_gemini_api_key_here

# Lưu trữ tệp tin: 'local' hoặc 's3'
STORAGE_DRIVER=local
